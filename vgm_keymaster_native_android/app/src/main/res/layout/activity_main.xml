<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050814">

    <com.vgmkeymaster.nativeapp.WaterfallSurfaceView
        android:id="@+id/waterfallView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Control Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#80050814"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Great Fairy Fountain (Zelda: BOTW)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="play"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnHandMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="both hands"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnLoop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="loop: on"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
